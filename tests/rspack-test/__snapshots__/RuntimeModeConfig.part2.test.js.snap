// Rstest Snapshot v1

exports[`runtimeModeConfig > runtimeModeConfigCases-configCases/module/import-meta > should pass 1`] = `
import {fileURLToPath as __rspack_fileURLToPath} from "node:url";
var __rspack_context={};
var __filename = __rspack_fileURLToPath(import.meta.url);
it("should work import.meta.env with EnvironmentPlugin", () => {
    expect("aaa").toBe("aaa");
});

it("should work import.meta.env with DotenvPlugin", () => {
    expect("https://api.example.com").toBe("https://api.example.com");
});

it("import.meta.env behaves like process.env", async (done) => {
    try {
        const importMetaEnv = ({ "AAA":"aaa","WEBPACK_API_URL":"https://api.example.com","NODE_ENV":"production" });
        importMetaEnv;
        const processEnv = process.env;
        processEnv;
        const UNKNOWN_PROPERTY = ({ "AAA":"aaa","WEBPACK_API_URL":"https://api.example.com","NODE_ENV":"production" }).UNKNOWN_PROPERTY;
        UNKNOWN_PROPERTY;
        const UNKNOWN_PROPERTY_2 = process.env.UNKNOWN_PROPERTY_2;
        UNKNOWN_PROPERTY_2;
        "object";
        typeof process.env;

        const { env } = ({["env"]: import.meta.env});
        env;
    } catch (_e) {
        // ignore
    }
    const fs = await eval("import('fs')");
    expect(fs.readFileSync(__filename, "utf-8")).toMatchSnapshot();
    done();
});
`;

exports[`runtimeModeConfig > runtimeModeConfigCases-configCases/module/import-meta-env > should pass 1`] = `
import {fileURLToPath as __rspack_fileURLToPath} from "node:url";
var __rspack_import_meta_filename__ = __rspack_fileURLToPath(import.meta.url);
var __rspack_context={};
it("should work import.meta.env with EnvironmentPlugin", () => {
    expect("aaa").toBe("aaa");
});

it("import.meta.env behaves like process.env", async (done) => {
    try {
        const importMetaEnv = {"AAA":"aaa","NODE_ENV":"production"};
        importMetaEnv;
        const processEnv = process.env;
        processEnv;
        const UNKNOWN_PROPERTY = undefined;
        UNKNOWN_PROPERTY;
        const UNKNOWN_PROPERTY_2 = process.env.UNKNOWN_PROPERTY_2;
        UNKNOWN_PROPERTY_2;
        'object';
        typeof process.env;

        const { env } = ({env: {"AAA":"aaa","NODE_ENV":"production"}});
        env;
    } catch (_e) {
        // ignore
    }
    const fs = await eval("import('fs')");
    expect(fs.readFileSync(__rspack_import_meta_filename__, "utf-8")).toMatchSnapshot();
    done();
});
`;
